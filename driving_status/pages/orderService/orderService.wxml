<view class="container">
	<view wx:if="{{isload}}" class="optical"></view>
	<map class="map" id="map" style="height:{{isWaiting?'80%':'77%'}}" scale="17" latitude="{{latitude}}" longitude="{{longitude}}" polyline="{{polyline}}" markers="{{markers}}" controls="{{controls}}" include-points='{{points}}' bindcontroltap="bindcontroltap" show-location="{{mapShowLocation}}">
	</map>
	<view class="total">
		<block wx:if="{{!isWaiting}}">
			<view class="total_driver">
				<view class="driver_info">
					<view class="driver_img">
						<image class="driverImg" src="/assets/images/driver.png" />
						<view class="name">王师傅</view>
					</view>
					<view class="driver_detailed">
						<view class="d_top">
							<view class="company">乐遍出行</view>
						</view>
						<view class="d_md">
							<view class="detailed_Cartnumber">晋AT2315</view>
							<!-- <view class="d_id">编号：Car124112</view> -->
						</view>
						<view class="detailed_cart">银白色 帕萨特</view>
					</view>
				</view>
				<view class="driver_icon">
					<view class="ic_phone" bindtap="callDriver" data-phone="15110321245">
						<image src="/assets/images/common_icon_phone.png" />
					</view>
				</view>
			</view>
			<view class="footer">
				<view class="enpty-box"></view>
				<!-- <view class="footer-box">
					<view wx:if="{{showCancleBtn}}" class="footer-desc" bindtap="cancleWait" style="width:{{firBtnWidth}}">取消订单</view>
					<view wx:if="{{fixedLine && showCancleBtn}}" class="footer-desc" bindtap="recallLine" style="width:{{firBtnWidth}}">重新呼叫</view>
					<view class="footer-desc2" bindtap="toService" style="width:{{firBtnWidth}}">联系客服</view>
				</view> -->
				<view class="footer-box">
					<view class="footer-desc2" bindtap="toService" style="width:{{secBtnWidth}}">联系客服</view>
					<view class="footer-desc2" bindtap="linePay" style="width:{{secBtnWidth}};color:#FF8008">{{linePayText}}</view>
					<view class="footer-desc2" bindtap="EXC_toLocalMap" style="width:{{secBtnWidth}}">导航到停车点</view>
				</view>
				<view class="line-has-pay">随时恭候 用心服务</view>
			</view>
		</block>

		<!-- 等待应答状态底部 -->
		<view wx:else class="wait-info">
		<!-- 远程 -->
      <view class="path-info1">
        <view class="path-time">起点:{{detail.IntoLocation}}</view>
        <view class="path-time">终点:{{detail.OffLocation}}</view>
      </view>
			<block>
				<view class="path-info">
					<view class="path-time">全程大约{{pathTime}}</view>
					<view class="distance">{{distance}}公里</view>
				</view>
        <view class="path-info">
					<view class="path-time">预计到达时间{{detail.ArrivalTime}}</view>
				</view>
				<view class="wait-price">
					<view class="tot">约<text class="tot_num">{{ygprice}}</text>元</view>
					<view class="desc">（已优惠{{yhprice}}元,余额支付还可优惠{{yueprice}}元）</view>
				</view>
			</block>
			<view class="wait-cancle"  bindtap="toCancel" wx:if="{{detail.FormState=='100004-0001020002' && (detail.IsPayment=='100004-0000010002' || !detail.IsPayment)}}">取消订单</view>
      <view class="wait-cancle1" bindtap="gotopay" wx:if="{{detail.IsPayment=='100004-0000010002' || !detail.IsPayment}}">立即支付</view>
      <view class="footer-box" wx:if="{{detail.IsPayment=='100004-0000010001'}}">
        <view class="footer-desc" bindtap="cancleWait" style="width:{{firBtnWidth}}">取消订单</view>
        <!-- <view class="footer-desc" bindtap="recallLine" style="width:{{firBtnWidth}}">重新呼叫</view> -->
        <view class="footer-desc2" bindtap="toService" style="width:{{firBtnWidth}}">联系客服</view>
      </view>
		</view>
	</view>
	<view wx:if="{{isWaiting && !fromFriendUseCart}}" class="wait" style="top:{{exclusiveCar && EXC_dateNum?'7%':'2%'}}">
		<block wx:if="{{fixedLine || exclusiveCar}}">
			<view class="wright line-tip">正在为您匹配</view>
		</block>
		<block wx:else>
			<view class="wleft">
				<view class="txt">等待</view>
				<view class="time">{{time}}</view>
			</view>
			<view class="wright">{{title_tips}}</view>
		</block>
	</view>

	<!-- <view class="walk-tips" style="top:{{exclusiveCar && EXC_dateNum?'7%':'2%'}}" hidden="{{hideWalkTips}}">
		<image src="/assets/images/walk.png"></image>
		<view>
			步行至<text>[{{detail.IntoLocation}}]</text>上车
		</view>
	</view> -->

