/* driving_status/pages/peizhenPay/peizhenPay.wxss */
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.container {
  padding-bottom: 40rpx;
}

/* --- 顶部 Banner --- */
.banner-section {
  position: relative;
  height: 360rpx;
  background: linear-gradient(135deg, #a8e6cf 0%, #dcedc1 100%); /* 浅绿色背景 */
  overflow: hidden;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.banner-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.main-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.sub-title {
  font-size: 24rpx;
  color: #555;
  margin-bottom: 30rpx;
  letter-spacing: 2rpx;
}

.service-tags {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.tag-item {
  font-weight: 500;
}

.divider {
  width: 1rpx;
  height: 24rpx;
  background-color: #999;
  margin: 0 15rpx;
}

.doctor-img {
  position: absolute;
  right: -20rpx;
  bottom: 0;
  width: 260rpx;
  height: 300rpx;
  z-index: 1;
  opacity: 0.9;
}

.form-table {
  background-color: #fff;
  border-radius: 12rpx;
  margin: 20rpx;
  padding: 0 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.form-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
}

.form-input-wrap input {
  width: 100%;
  font-size: 30rpx;
  color: #333;
}

.picker-text {
  font-size: 30rpx;
  color: #333;
}

.placeholder {
  color: #999;
}

.submit-btn {
  margin: 40rpx 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
}