<!--components/distanceNav/distanceNav.wxml-->
<view class="page">
  <view class="main">
    <view class="main_item">
      <view class="day">
        <view class="dayBtn">
          <picker mode="date" value="{{date}}" start="{{StartDay}}" end="{{EndDay}}" bindchange="bindDateChange">
            {{propsTxt}}
          </picker>
          <picker mode="date" value="{{date}}" start="{{StartDay}}" end="{{EndDay}}" bindchange="bindDateChange">
            {{propsDay}}
          </picker>
        </view>
      </view>
      <view class="path">
        <picker  value="{{index}}" range-key="Name" range="{{addArr}}"  bindchange="bindPickerLine">
          {{startingCity}} —— {{endingCity}}
          </picker>
          <picker value="{{index}}"  range="{{TimeList}}"  bindchange="bindPickerTime" wx:if="{{time_seatNum == 1}}">
            {{StartTime}} ~ {{EndTime}}
          </picker>
          <view wx:else class="timeSeatNum">车辆已满</view>
      </view>
      <view class="money">￥ {{Price}}</view>
    </view>
  </view>

</view>