.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  background: #fff;
  width: 80%;
  border-radius: 12rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.modal-input {
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.modal-buttons {
  display: flex;
  justify-content: space-between;
}

.btn {
  flex: 1;
  margin: 0 10rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  border-radius: 8rpx;
}

.cancel {
  background: #f5f5f5;
  color: #666;
}

.confirm {
  background: #07c160;
  color: #fff;
}