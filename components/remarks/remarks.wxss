/* components/remarks/remarks.wxss */

.remakes {
	position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0,.7);
  z-index: 9999;
  overflow: hidden;
}

@keyframes slide-up{
  from{
    bottom: -650rpx;
  }
  to{
    bottom: 0;
  }
}

.inner{
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 650rpx;
  background: linear-gradient(180deg, rgb(255, 255, 255) 0%,rgba(240,135,24,1) 100%);
  box-sizing: border-box;
  padding: 20rpx;
  color: #333;
  animation: slide-up .5s;
}
.nav {
	height: 70rpx;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.nav .nav_l {
	display: flex;
	flex: 1;
}
.nav .nav_r {
	flex: 1;
	
}
.nav .nav_r .submit {
	width: 160rpx;
	height: 60rpx;
	line-height: 60rpx;
	text-align: center;
	color: #fff;
	background: linear-gradient(180deg, rgba(253,209,0,1) 0%,rgba(240,135,24,1) 100%);
	border-radius: 10rpx;
	float: right;
	box-shadow: 0 2px 4px rgba(0, 0, 0, .12), 0 0 6px rgba(0, 0, 0, .44);
}
.textareaClass {
	font-size: 12px;
}
.textarea {
	font-size: 14px;
	line-height: 34rpx;
	box-shadow: 0 2px 4px rgba(0, 0, 0, .12), 0 0 6px rgba(0, 0, 0, .44);
	border: 1px solid #BBBBBB;
	border-radius: 20rpx;
	margin-top: 10rpx;
	background-color: #fff;
	padding: 10rpx 0;
	width: 100%;
	height: 188rpx;
	white-space: pre-wrap; /* 保持空白符，包括换行 */
  text-indent: 2em; /* 首行缩进2个字符的宽度 */
}
.txt {
	position: relative;
}
.txt image{
	width: 40rpx;
	height: 40rpx;
	position: absolute;
	top: 10rpx;
	left: 10rpx;
	z-index: 999;
}
.options {
	height: 450rpx;

}
.options .item {
	display: inline-block;
	height: 60rpx;
	padding: 0 10rpx;
	margin: 0 10rpx;
	border: 1px solid rgb(104, 103, 103);
	color: rgb(104, 103, 103);
	border-radius: 10rpx;
	margin-top: 20rpx;
	font-size: 14px;
	line-height: 60rpx;
}