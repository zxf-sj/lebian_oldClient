/* components/modelComponent/modelComponent.wxss */

.modelComponent {
	position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0,.7);
  z-index: 9999;
  overflow: hidden;
}

@keyframes slide-up{
  from{
    bottom: -650rpx;
  }
  to{
    bottom: 0;
  }
}

.inner{
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 650rpx;
  background: linear-gradient(180deg, rgb(255, 255, 255) 0%,rgba(240,135,24,1) 100%);
  box-sizing: border-box;
  padding: 20rpx;
  color: #333;
  animation: slide-up .5s;
}

.nav {
	height: 70rpx;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.nav .nav_l {
	display: flex;
