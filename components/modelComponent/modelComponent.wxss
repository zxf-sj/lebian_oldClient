}
.nav .nav_r {
	flex: 1;
	
}
.nav .nav_r .submit {
	width: 160rpx;
	height: 60rpx;
	line-height: 60rpx;
	text-align: center;
	color: #fff;
	background: linear-gradient(180deg, rgba(253,209,0,1) 0%,rgba(240,135,24,1) 100%);
	border-radius: 10rpx;
	float: right;
	box-shadow: 0 2px 4px rgba(0, 0, 0, .12), 0 0 6px rgba(0, 0, 0, .44);
}
