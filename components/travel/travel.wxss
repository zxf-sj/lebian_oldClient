/* components/travel/travel.wxss */
.information {
	box-shadow: 0 2px 4px rgb(0, 0, 0,.4), 0 0 6px rgba(0, 0, 0, .04);
	margin: 30rpx 20rpx 20rpx;
	border-radius: 10px;
}
.isChildren {
  display: inline;
  font-size: 12px;
  color: #04d661;
}
.information .destination {
	display: flex;
	min-height: 100rpx;
	border-bottom: 1px solid #ccc;
}
.information .destination1 {
	border-bottom: 1px solid #ccc;
}
.information .destination1 .perpo_num {
	width: 100%;
	display: flex;
	height: 100rpx;
}


.information .destination .left {
	width: 220rpx;
	display: flex;
	align-items: center;
	color: #101010;
  padding-left: 50rpx;
  box-sizing: border-box;
}
.information .destination .right {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #BBBBBB;
	font-size: 14px;
}
.information .destination1 .perpo_num .left {
	flex: 1;
	display: flex;
	align-items: center;
	color: #101010;
  padding-left: 50rpx;
  box-sizing: border-box;
}
.information .destination1 .perpo_num .left2 {
	flex: 1;
	display: flex;
	align-items: center;
	color: #101010;
}
.information .destination1 .perpo_num .left2 .left_l {
  width: 220rpx;
  padding-left: 50rpx;
  box-sizing: border-box;
}
.information .destination1 .perpo_num .left2 .names {
  color: #F08718;
}
.information .destination1 .perpo_num .right {
	width: 220rpx;
	display: flex;
	align-items: center;
	justify-content: flex-end;
	color: #F08718;
	margin-right: 10rpx;
}
.information .destination1 .perpo_num .right .count {
    width: 200rpx;
    height: 100%;
    display: flex;
}
.information .destination1 .perpo_num .right .jia {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 100%;
}
.information .destination1 .perpo_num .right .jia .jiaitem {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40%;
    width: 100%;
    border: 1px solid #ccc;
    border-radius: 10rpx;
}
.information .destination1 .perpo_num .right .num {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    flex: 1;
    
}
.information .destination1 .perpo_num .right .jian {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    flex: 1;
}
.information .destination1 .perpo_num .right .jian .jianitem {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40%;
    width: 100%;
    border: 1px solid #ccc;
    border-radius: 10rpx;
}
.information .remarks {
	font-size: 12px;
	height: 150rpx;
	line-height: 40rpx;
	padding: 20rpx;
  box-sizing: border-box;
	color: #F08718;
}
.btnAdd {
	width: 150rpx;
	height: 50rpx;
	border: 1px solid #F08718;
	border-radius: 10rpx;
	color: #F08718;
	text-align: center;
	font-size: 14px;
	line-height: 50rpx;
}