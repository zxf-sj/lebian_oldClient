<!--components/travel/travel.wxml-->
<view class="page">
  <view class="information">
    <view class="destination1">
      <view class="perpo_num" >
        <view class="left">乘车人数</view>
        <view class="right ">
          <view class="count">
            <view class="jia" bind:tap="addPerson">
              <view class="jiaitem">+</view>
            </view>
            <view class="num">{{numberOfPeople}}</view>
            <view class="jian" bind:tap="reducePerson">
              <view class="jianitem">-</view>
            </view>
          </view>
        </view>
      </view>
      <view class="perpo_num">
        <view class="left">乘车人信息</view>
        <view class="right ">
          <view class="btnAdd" bindtap="handlePerson">添加/修改</view>
        </view>
      </view>
      <view class="perpo_num" wx:for="{{numberOfPeople}}" wx:key="index">
        <view class="left2">
          <view class="left_l">乘车人{{index + 1}}</view>
          <view class="names">{{personArr[index].RealName}}
            <view class="isChildren" wx:if="{{personArr[index].isChildren == '100004-0000010001'}}" wx:key="index">儿童
            </view>
          </view>
        </view>
        <view class="right">
          <view class="phoen">
            {{personArr[index].Phone}}
          </view>
        </view>
      </view>

    </view>

    <view class="destination">
      <view class="left">乘车备注</view>
      <view class="right" bind:tap="handleRemarks" style="{{textareaValue?'color:#010101;':'color:#bbbbbb;'}}">
        {{textareaValue?textareaValue:'请输入乘客特殊需求'}}
      </view>
    </view>
    <view class="remarks">
      * 如是否携带大件行李、飞机航班号、列车车次及乘坐时间、是否是孕妇或老人、是否是孩童单独乘车等，以便更好的为您服务。
    </view>
  </view>
  <!-- 显示乘车人 -->
  <passenger bind:customEvent="handleCustomEvent" personArr="{{personArr}}" typeon="{{typeon}}" wx:if="{{passenger}}" passenger="{{passenger}}" />
  <!-- 显示备注信息 -->
  <remarks bind:textareaValue="handleTextareaValue" wx:if="{{remark}}" remark="{{remark}}" />
</view>