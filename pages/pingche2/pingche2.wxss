/* 基础三角形样式 */
.arrow-container {
    width: 140rpx;
    height: 120rpx;
    line-height: 120rpx;
    font-size: 28rpx;
    color: #0d88d0;    
    text-decoration: underline;
}
  
  /* 向下箭头 */
  .arrow-down {
    width: 0;
    height: 0;
    border-left: 15rpx solid transparent;
    border-right: 15rpx solid transparent;
    border-top: 26rpx solid rgba(240,135,24,1);
    transition: all 0.3s ease;
  }
  
  /* 点击后翻转效果 */
  .arrow-container.flipped {
    transform: rotate(180deg);
  }
.passenger {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0,.7);
  z-index: 9999;
  overflow: hidden;
  
}

@keyframes slideDown {
    0% { 
        bottom: -300rpx;
        opacity: 0.3;
    }
    100% { 
        bottom: 0;
        opacity: 1;
    }
}
.priceDetail {
    min-height: 300rpx;
    animation: slideDown 1s forwards;
    width: 100%;
    background-color: #fff;
    position: absolute;
    left: 0;
    border-top-left-radius: 20rpx;      /* 左上角 */
    border-top-right-radius: 20rpx;     /* 右上角 */
    padding-bottom: 30rpx;
}
.DetailTitle {
    position: relative;
    height: 100rpx;
    width: 100%;
    line-height: 100rpx;
    text-align: center;
    color: #323232;
    font-weight: 600;
}
.DetailTitle .xxx {
