.container{
  position: relative;
  width: 100%; 
  height: 100vh; 
  background-color: #eee;
}
.location{
    width: 100%;
    height: 88rpx;
    top: 0;
    background-color: #fff;
    font-size: 28rpx;
    position: relative;
  }
  .location-city{
    height: 88rpx;
    position: absolute;
    width: 160rpx;
    line-height: 88rpx;
    text-align: center;
    color: #333333;
    font-size: 36rpx;
    font-weight: bold;
  }

  .arrow-icon{
    width: 40rpx;
    height: 40rpx;
    position: absolute;
    top: 50% ;
    left: 160rpx ;
    transform: translateY(-50%);
  }
  .arrow-icon1{
    width: 26rpx;
    height: 26rpx;
    position: absolute;
    top: 11.5%;
    left: 158rpx;
    transform: translateY(-50%);
  }
  .dott_line1{
    position: absolute;
    left: 200rpx;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 30rpx;
    border-right: 2rpx dotted #f2f2f2;
    z-index: 999;
  }
  
  .dott_line2{
    position: absolute;
    left: 630rpx;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 30rpx;
    border-right: 2rpx dotted #f2f2f2;
    z-index: 999;
  }

  .location-input{
    height: 88rpx;
    width: 390rpx;
    margin-left: 232rpx;
    line-height: 88rpx;
  }
  .location-cancel{
    width: 120rpx;
    height: 88rpx;
    position: absolute;
    right: 0;
    top: 0;
    line-height: 88rpx;
    color: #999;
    text-align: center;
  }
  .addressList{
    position: fixed;
    /* top:470rpx; */
    top:156rpx;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999;
    border-radius: 10rpx;
  }
  .destination{
    box-sizing: border-box;
    top: 50rpx;
    width: 710rpx;
    background-color: #fff;
  }
  .destination-content{
    width: 712rpx;
    height: 168rpx;    
    border-bottom: 1px solid #f2f2f2;
    box-shadow:3px 5px 10px #f2f2f2;
    display: flex;
    align-items: center;
  }
  .content-image{
      width: 80rpx;
      height: 119rpx;
      line-height: 119rpx;
      text-align: center;
  }
  .destination-content image{
    width: 32rpx;
    height: 32rpx;
    opacity: 1;
    color: #999999;

  }
  .content{
    width: 240px;
    box-sizing: border-box;
    overflow: hidden;
  }
  .content-name{
      display: block;
      color: #333333;
      font-size: 28rpx;
  }
  .content-detail{
    display: block;
    color: #999999;
    font-size: 24rpx;
    width: 100%;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    margin-top: 16rpx;
}
.distance{
  margin-left: 40rpx;
  width: 100rpx;
  color: #333333;
  font-size: 26rpx;
}

.wrapper{
  padding: 20rpx 30rpx;
}

.home_comp{
  height: 80rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  font-size: 32rpx;
  border-radius: 10rpx;
}

.home_comp image{
  width: 50rpx;
  height: 50rpx;
  margin-right: 30rpx;
}

.home_comp>.home,.home_comp>.company{
  flex: 1;
  display: flex;
  align-items: center;
}

.home_comp .t{
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.home_comp .b{
  color: #999;
  font-size: 28rpx;
}

.home_comp .text{
  flex: 1;
}

.used-location image{
  width: 20rpx;
  height: 20rpx;
  padding: 0 30rpx;
}
  
.tit{
  padding: 20rpx 0;
  font-size: 42rpx;
  font-weight: bold;
}

.used-location>.list{
  display: flex;
  flex-wrap: wrap;
  font-size: 32rpx;
}

.used-location .item{
  width: 48%;
  height: 60rpx;
  line-height: 60rpx;
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.lo_name{
  flex: 1;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  word-break: break-all;
}

.used-location .item:nth-of-type(odd){
  margin-right: 4%;
}

.his_scroll{
  height: 400rpx;
}

.his_cont{
  width: 600rpx;
}

.history>.tit{
  padding-top: 0;
}

.history .item{
  display: flex;
  align-items: center;
  width: 100%;
  height: 120rpx;
  background-color: #fff;
  padding: 10rpx 0;
  margin-bottom: 5rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
}

.history image{
  width: 30rpx;
  height: 30rpx;
  padding: 0 30rpx;
}

.his_desc{
  font-size: 28rpx;
  color: #999;
}

.clear-his{
  text-align: center;
  font-size: 30rpx;
  color: #5093E1;
  margin-top: 10rpx;
}

.no-his{
  text-align: center;
  font-size: 30rpx;
  color: #999;
}
.fixed-line{
  position: absolute;
  /* top:406rpx; */
  top: 98rpx;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background-color: #f2f2f2;
  padding-left: 30rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.exclusive-car{
  position: absolute;
  /* height: 100%; */
  top: 108rpx;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background-color: #f2f2f2;
  padding: 30rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.fixed-line view,.exclusive-car view{
  box-sizing: border-box;
}

.cur-city{
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #fff;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333;
}

.exclusive-car-city{
  margin-bottom: 30rpx;
}

.title{
  /**padding: 30rpx 0 24rpx;**/
  font-size: 32rpx;
  color: #333;
}

.sub-item{
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 80rpx;
  background-color: #fff;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.sub-item .sub-title{
  line-height: 80rpx;
}

/* .sub-item .sub-price{
  width: 90rpx;
} */

.sub-item .actual-price{
  font-weight: bold;
  color: #FF8008;
  text-align: right;
}

.sub-item .del-price{
  text-decoration: line-through;
  color: #999;
  font-size: 20rpx;
  text-align: right;
}

.no-line-list{
  width: 300rpx;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  font-size: 28rpx;
  color: #FF8008;
  text-align: center;
}
.no-line-list image{
  width: 300rpx;
  height: 300rpx;
}

.no-line{
  text-align: center;
  font-size: 28rpx;
  color: #999;
}
.hotcity-wrap {
  font-size:28rpx;
  color: #333;
  background-color: white;
  border-bottom: 1px solid #eee;
}
.title1 {
  margin-left: 20rpx;
  padding-top: 20rpx;
  margin-top: 2rpx;
  font-size: 32rpx;
}
.hotcity-item {
  width: calc(calc(100vw - 120rpx - 80rpx) / 4);
  margin-top: 40rpx;
  height:50rpx;
  margin-left: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 16rpx;
  background-color: #eee;
}
.item-wrap {
  display: flex;
  flex-wrap: wrap;
  padding-bottom:40rpx;
}