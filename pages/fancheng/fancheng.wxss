/* ---------- 布局骨架 ---------- */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  box-sizing: border-box;
}

/* ---------- 顶部 ---------- */
.header {
  flex: none;
  padding: 16rpx 24rpx 0;
}
.route {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 18rpx;
}
.route-city {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
  margin: 0 14rpx;
}
.route-arrow {
  font-size: 34rpx;
  color: #333;
}
.route-caret {
  font-size: 30rpx;
  color: #666;
  margin-left: 8rpx;
}
.notice {
  display: flex;
  align-items: center;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
}
.notice-bell { font-size: 26rpx; margin-right: 10rpx; }
.notice-text {
  flex: 1;
  font-size: 26rpx;
  color: #444;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.notice-arrow { font-size: 30rpx; color: #999; margin-left: 8rpx; }

/* ---------- 双列 ---------- */
.columns {
  flex: 1;
  display: flex;
  min-height: 0;
}
.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  border-top: 8rpx solid #ffe14d;
}
.col + .col {
  border-left: 2rpx solid #eee;
}
.col-top { flex: none; padding: 16rpx 16rpx 0; }

.col-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.col-title {
  font-size: 38rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
}

/* 日期条（左右滑动） */
.date-bar {
  white-space: nowrap;
  width: 100%;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f2f2f2;
}
.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  padding: 12rpx 10rpx;
  margin-right: 10rpx;
  border-radius: 12rpx;
  vertical-align: top;
}
.date-item.on { background: #ffe14d; }
.date-md { font-size: 28rpx; font-weight: 700; }
.date-week { font-size: 24rpx; margin-top: 2rpx; }
.date-label { font-size: 20rpx; color: #888; margin-top: 2rpx; }
.date-cal {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  font-size: 30rpx;
  vertical-align: top;
}
.date-cal-caret { font-size: 20rpx; color: #666; }

/* 列表（上下滑动） */
.list {
  flex: 1;
  min-height: 0;
}
.card {
  padding: 22rpx 16rpx;
  border-bottom: 2rpx solid #f2f2f2;
  background: #fff;
  position: relative;
}
.card.sel { background: #fffdf0; }

.card-time {
  display: flex;
  align-items: flex-start;
}
.t-box { display: flex; flex-direction: column; min-width: 0; }
.t-box.right { align-items: flex-end; }
.t-big { font-size: 40rpx; font-weight: 800; }
.t-day { font-size: 22rpx; color: #666; }
.t-airport { font-size: 24rpx; color: #333; margin-top: 4rpx; }
.t-line {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  margin-top: 26rpx;
}
.t-line::before {
  content: "";
  flex: 1;
  border-top: 2rpx solid #ccc;
}
.t-line-arrow { color: #bbb; font-size: 24rpx; margin-left: -6rpx; }

.card-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}
.swap {
  font-size: 36rpx;
}

/* 临近日期 / 邻近城市 */
.near {
  padding: 22rpx 16rpx;
  border-bottom: 2rpx solid #f2f2f2;
}
.near-title {
  font-size: 28rpx;
  color: #4a90d9;
  font-weight: 700;
  display: block;
  margin-bottom: 14rpx;
}
.near-box {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.near-left { display: flex; flex-direction: column; }
.near-row { font-size: 26rpx; color: #333; display: flex; align-items: center; margin-bottom: 8rpx; }
.near-row:last-child { margin-bottom: 0; }
.near-tag {
  font-size: 20rpx;
  color: #666;
  border: 2rpx solid #ccc;
  border-radius: 4rpx;
  padding: 0 6rpx;
  margin-right: 12rpx;
}
.near-desc { font-size: 22rpx; color: #999; margin-top: 14rpx; display: block; line-height: 1.6; }

/* ---------- 底部操作栏 ---------- */
.bottom {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #eee;
  background: #fff;
}
.next-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: #ffe14d;
  border-radius: 42rpx;
  font-size: 32rpx;
  font-weight: 700;
}

/* ---------- 弹框 ---------- */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, .45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  border-bottom: 2rpx solid #f2f2f2;
}
.sheet-cancel { font-size: 28rpx; color: #999; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-holder { width: 60rpx; }

/* 线路列表（上下滑动） */
.route-list {
  flex: 1;
  max-height: 760rpx;
  padding: 8rpx 30rpx 0;
  box-sizing: border-box;
}
.route-row {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 2rpx solid #f2f2f2;
}
.route-row.sel { background: #fffdf0; }
.rr-city {
  font-size: 32rpx;
  font-weight: 700;
  font-family: "Songti SC", "STSong", serif;
}
.rr-line {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rr-arrow { font-size: 28rpx; color: #999; margin: 0 20rpx; }
.rr-check { font-size: 30rpx; color: #e6a23c; margin-left: 16rpx; font-weight: 700; }
.aaa {
  color: #4a90d9;
}
.disbal {
  background-color: #d0d0d0 !important;
}