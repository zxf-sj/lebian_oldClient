.container {
  padding: 20rpx;
  background-color: #eee;
}
 
.car-card {
  background: #fefefe;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
 
.car-image {
  width: 100%;
  height: 400rpx;
}
 
.info-box {
  padding: 30rpx;
}
 
.car-type {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}
 
.car-detail {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}
 
.price {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF4444;
  display: block;
  margin-bottom: 30rpx;
}
 
.book-btn {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  font-size: 28rpx;
  background: linear-gradient(45deg, #007AFF, #0055CC);
}
 
.book-btn::after {
  border: none;
}
.bg{
  padding: 0 50rpx;
  margin:100rpx auto 0;
  text-align: center;
  color: #9A9A9A;
  font-size: 28rpx;
}

.bg-img{
  width: 324rpx;
  height: 317rpx;
  margin-bottom: 21rpx;
}

.bg-cont{
  color: #FF8008;
}