@import '../../../app.wxss';

.page {
  width: 100%;
  box-sizing: border-box;
  height: 100%;
  display: flex;
  flex-direction:column;
  flex-wrap: wrap;
  overflow-x: hidden;
}
.nav {
	width: 100%;
	height: 160rpx;
	background: linear-gradient(180deg, rgba(253,209,0,1) 0%,rgba(240,135,24,1) 100%);
	display: flex;
	align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}
.nav .tab_keep {
  height: 70%;
  flex: 1;
  color: #fff;
}
.nav .handle_keep {
  background-color: #fff;
  border-radius: 10rpx;
  color: #F08718;
}
.nav .tab_keep .item {
  width: 100%;
  text-align: center;
 
}
.main {
  padding: 0 20rpx;
  color: #fff;
  font-weight: 500;
  flex: 1;
}
.scroll-view {
  height: calc(100vh - 180rpx);
  overflow: hidden;
}
.main .main_item {
  display: flex;
  justify-content: space-between;
  padding: 0 30rpx;
  height: 160rpx;
  margin-top: 20rpx;
  /* background: linear-gradient(180deg, rgba(253,209,0,1) 0%,rgba(240,135,24,1) 100%); */
  color: #101010;
  border-radius: 10rpx;
  box-shadow: rgba(0, 0, 0, 0.08) 0px 0px 3px 1px;
  border: 1px solid #EBEEF5;
  font-size: 14px;
}
.main .main_item .item_left {
 padding: 30rpx 0;
 width: 50%;
}
.main .main_item .item_left .path {
  width: 100%;
  height: 50%;
  display: flex;
  align-items: left;
}
.main .main_item .item_left .time {
  width: 100%;
  height: 50%;
  display: flex;
  align-items: left;
}
.main .main_item .item_right {
  padding: 30rpx 0;
  width: 34%;
 }
 .main .main_item .item_right .seat {
   width: 100%;
   height: 50%;
   display: flex;
   align-items: left;
   justify-content: center;
   
 }
 .main .main_item .item_right .money {
   width: 100%;
   height: 50%;
   display: flex;
   align-items: left;
   justify-content: center;
 }
 .main .soldOut {
   background: none;
   color: #ffffff;
   background: linear-gradient(180deg, rgba(253,209,0,1) 0%,rgba(240,135,24,1) 100%);
 }
 .bottom {
   height: 20rpx;
 }