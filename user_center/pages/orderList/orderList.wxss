
@import '../../../app.wxss';
page{
  width: 100%;
  background-color: #f4f6f8;
}

.container{
  height: 100vh;
  width: 100%;
  padding: 0 20rpx 40rpx 20rpx;
  box-sizing: border-box;
}

.hiddenBar{
  width: 100%;
  overflow: hidden;
  overflow-y: scroll;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.listBox{
  width: 100%;
  background-color: #fff;
  margin-top: 40rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  border-radius: 5px;
}

.flex-title {
  display: flex;
  justify-content: space-between;
  color: #333;
  line-height: 80rpx;
  align-items: center;
}

.status{
  color: #999;
}

.iconRight{
  width: 20rpx;
  height: 20rpx;
  display: inline-block;
  border-top: 1px solid #999;
  border-right: 1px solid #999;
  transform: rotate(45deg);
  margin-left: 20rpx;
}

.list-time{
  height: 60rpx;
  align-items: center;
}

.list-time image{
  width: 32rpx;
  height: 32rpx;
  vertical-align: middle;
  margin-right: 10rpx;
}

.time{
  color: #999;
}

.list-adress{
  line-height: 60rpx;
  color: #999;
}

.circle{
  height: 10px;
  width: 10px;
  display: inline-block;
  border-radius: 50%;
  margin: 0 20rpx 0 5rpx;
}

.circle-str{
  background: #3cbca3;
}

.circle-end{
  background: #fc9153;
}

.bg{
  padding: 0 50rpx;
  margin: 216rpx auto 0;
  text-align: center;
  color: #9A9A9A;
  font-size: 28rpx;
}

.bg-img{
  width: 324rpx;
  height: 317rpx;
  margin-bottom: 21rpx;
}

.bg-cont{
  color: #FF8008;
}
.btn-list{
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 10rpx;
}
.btn-area{
  /* width: 22%; */
  margin-right: 10rpx;
}
.tuik{
  background: #f1c00f;
  color: #fff;
}
.pingjia{
  background: #3cbca3;
  color: #fff;
}
.kaipiao{
  background: #fc9153;
  color: #fff;
}
.popup-box{
  position: absolute;
  z-index: 99;
  top: 0;
  background-color: rgba(0, 0, 0, 0.5);
  width: 100%;
  height: 100%;
}
/* 下 */
.info-bottom{
  position: fixed;
  z-index: 999;
  width: 100%;
  bottom: 0;
  background-color: white;
  border-top-left-radius: 10rpx;
  border-top-right-radius: 10rpx;
}
button{
  margin: 15rpx 0;
}
.row-info{
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 15rpx;
  font-size: 32rpx;
  height: 200rpx;
}
.row-info view{
  padding: 10rpx 0;
  margin-top: 20rpx;
}
.row-info view:first-child{
  display: flex;
  flex-direction: row;
  align-items: center;
}
.line{
  width: 100rpx;
  height: 1rpx;
}
.left-line{
  background-image: linear-gradient(to left,orange,white);
}
.right-line{
  background-image: linear-gradient(to right,orange,white);
}
.row-author{
  font-size: 24rpx;
  color: gray;
}
.row-btn{
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1rpx dashed #f1f1f1;
}
.row-btn view{
  flex: 1;
  text-align: center;
  margin: 20rpx 10%;
  padding: 12rpx 0;
  font-size: 32rpx;
  border-radius: 10rpx;
}
.left-btn{
  background-color: #f1f1f1;
  color: #33ccff;
}
.right-btn{
  background-color: #33ccff;
  color: white;
}
.fixed{
  position: fixed;
  bottom: 0;
  width: 50%;
}
.yutime{
  font-size: 28rpx;
  color: #777;
  margin-right: 20rpx;
}
.yue{
  position: relative;
  top: -8rpx;
  left: 550rpx;
  width: 100rpx;
  height: 100rpx;
  margin-top: -100rpx;
}
.yuimg{
  width: 100rpx;
  height: 100rpx;
}
.menu-box {
  position: fixed;
  width: 100rpx;
  padding-bottom: 100rpx;
}
.menu-box .navbar {
  z-index: 1000;
  position: absolute;
  bottom: 0rpx;
  width: 100rpx;
  height: 100rpx;
  text-align: center;
  background-color: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: 0rpx;
  border-radius: 50%;
}
.menu-box .navbar>.btn {
  padding: 25rpx;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}
.menu-box .navbar>.btn>.line1 {
  height: 6rpx;
  background-color: white;
  margin: 0px 2rpx 6rpx 2rpx;
  border-radius: 6rpx;
}
.menu-box .navbar>.btn>.title {
  font-size: 20rpx;
}
.menu-box .active {
  background-color: pink;
}
.menu-box .menu{
  /* width: 100rpx; */
  height: 100rpx;
  /* overflow: hidden; */
  position: relative;
  /* margin: 0 auto; */
  bottom: -100rpx;
}
.menu-box .menu>view {
  z-index: 100;
  background-color: rgba(0, 0, 0, 0.6);
  margin-bottom: 20rpx;
  border-radius: 50%;
  height: 100rpx;
  line-height: 100rpx;
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  margin-left: auto;
  margin-right: auto;
  opacity: 0;
  font-size: 0rpx;
  color: red;
}
.menu-box .menu>view text{
  display: inline-block;
  position: absolute;
  text-align: center;
  width:100%;
  height: 100%;
  color: white;
  z-index: 10000;
  font-size: 25rpx;
}
.menu_box{
  display: flex;
  height: 80rpx;
}
.menu1,.menu2{
  flex: 1;
  font-size:30rpx;
  line-height: 80rpx;
  text-align: center;
}
.borders{
  border-bottom: 4rpx solid #f00;
  color: #f00;
}
