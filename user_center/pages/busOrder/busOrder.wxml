<!--user_center/pages/busOrder/busOrder.wxml-->
<!-- pages/order-confirm/order-confirm.wxml -->
<view class="container">
  
  <!-- 1. 顶部行程信息卡片 -->
  <view class="card trip-card">
    <view class="trip-header">
      <view class="station-item" bind:tap="handleStart">
        <view class="dot start"></view>
        <text class="station-name">{{startingStation.LocationName}}</text>
      </view>
      <!-- 虚线连接 -->
      <view class="dashed-line"></view>
      <view class="station-item" bind:tap="handleEnd">
        <view class="dot end"></view>
        <text class="station-name">{{terminal.LocationName}}</text>
      </view>
    </view>

    <view class="trip-details">
      <view class="time-row">
        <view class="time-left">
          <text class="icon">🕒</text>
          <text class="time-text">{{busDay}} {{time}}</text>
          <text class="tip-text">请在该时间前到达上车点候车</text>
        </view>
        <!-- <view class="ticket-count">余 {{tripInfo.remainTickets}}</view> -->
      </view>
      
      <!-- <view class="rules-row">
        <view class="rule-item">
          <text class="check-icon">✅</text>
          <text>{{tripInfo.cancelRule}}</text>
        </view>
        <view class="rule-item">
          <text class="check-icon">✅</text>
          <text>免费改签</text>
        </view>
        <text class="link-text">退改签规则 ></text>
      </view> -->
    </view>
  </view>

  <!-- 2. 乘车人列表 -->
  <view class="card passenger-card">
    <block wx:for="{{passengers}}" wx:key="id">
      <view class="passenger-item">
        <view class="p-info">
          <text class="p-name">{{item.name}}</text>
          <!-- <text class="p-type">{{item.type}}</text> -->
          <text class="p-id">{{item.phone}}</text>
        </view>
        <view class="p-action" bindtap="removePassenger" data-index="{{index}}">
          <text class="delete-icon">❌</text>
        </view>
      </view>
    </block>

    <!-- 添加按钮 -->
    <view class="add-btn" bindtap="openPopup">
      <text class="plus-icon">➕</text>
      <text>添加乘车人</text>
    </view>
  </view>

  <!-- 3. 联系人信息 -->
  <view class="card contact-card">
    <!-- <view class="row-item" bindtap="chooseContact">
      <view class="left">
        <text class="icon">📞</text>
        <text>{{contactPhone || '请选择联系人'}}</text>
      </view>
      <view class="right">
        <text class="sub-text" wx:if="{{contactName}}">{{contactName}}</text>
        <text class="arrow">></text>
      </view>
    </view> -->
    
    <!-- <view class="divider"></view> -->

    <view class="row-item">
      <view class="left">
        <text class="icon">📝</text>
        <text>备注</text>
      </view>
      <view class="right">
        <input class="input-note" placeholder="无备注" placeholder-class="placeholder-style" bindinput="onInput" />
        <!-- <text class="arrow">></text> -->
      </view>
    </view>
  </view>

  <!-- 4. 优惠券 -->
  <!-- <view class="card coupon-card">
    <view class="row-item">
      <view class="left">
        <text class="icon">🎫</text>
        <text>优惠券</text>
      </view>
      <view class="right">
        <text class="sub-text text-grey">不可用</text>
        <text class="arrow">></text>
      </view>
    </view>
  </view> -->

  <!-- 占位符，防止内容被底部栏遮挡 -->
  <view style="height: 120rpx;"></view>
  <!-- 遮罩层 -->
<view class="mask" wx:if="{{showPopup}}" bindtap="onCancel"></view>

<!-- 底部弹框 -->
<view class="popup {{showPopup ? 'popup-show' : ''}}">
  <view class="popup-title">填写信息</view>

  <view class="form-item">
    <text class="label">姓名</text>
    <input 
      class="input" 
      placeholder="请输入姓名" 
      value="{{name}}" 
      bindinput="onNameInput"
    />
    <text class="error" wx:if="{{nameError}}">{{nameError}}</text>
  </view>

  <view class="form-item">
    <text class="label">电话</text>
    <input 
      class="input" 
      type="number" 
      maxlength="11"
      placeholder="请输入手机号" 
      value="{{phone}}" 
      bindinput="onPhoneInput"
    />
    <text class="error" wx:if="{{phoneError}}">{{phoneError}}</text>
  </view>

  <view class="btn-group">
    <button class="btn btn-cancel" bindtap="onCancel">取消</button>
    <button class="btn btn-confirm" bindtap="onConfirm">确定</button>
  </view>
</view>
</view>

<!-- 5. 底部固定操作栏 -->
<view class="bottom-bar">
  <view class="price-info">
    <text class="label">合计：</text>
    <text class="price">¥{{totalPrice}}</text>
  </view>
  <button class="submit-btn" bindtap="submitOrder">提交订单</button>
</view>