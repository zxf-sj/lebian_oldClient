/* user_center/pages/invoiceImg/invoiceImg.wxss */
.container {
    background-color: #f0f2f5;
    min-height: 100vh;
    padding: 20rpx;
    box-sizing: border-box;
  }
  
  .list-container {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }
  
  .item-card {
    background: #ffffff;
    border-radius: 12rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }
  
  .item-header {
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #eee;
    margin-bottom: 20rpx;
  }
  
  .item-title {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
    text-align: center;
  }
  
  .image-section {
    margin: 20rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .preview-image {
    width: 100%;
    height: 300rpx;
    border-radius: 8rpx;
    background-color: #f9f9f9;
    border: 1rpx solid #ddd;
  }
  
  .image-actions, .pdf-actions {
    display: flex;
    gap: 20rpx;
    width: 100%;
    justify-content: center;
    margin-top: 20rpx;
  }
  
  .action-btn {
    flex: 1;
    max-width: 300rpx;
    border-radius: 8rpx;
    font-size: 26rpx;
    padding: 4rpx;
    border: none;
    margin: 0;
  }
  
  .action-btn.view {
    background-color: #07c160;
    color: white;
  }
  
  .action-btn.download {
    background-color: #10aeff;
    color: white;
  }
  
  .action-btn::after {
    border: none;
  }
  
  .pdf-section {
    margin: 20rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20rpx;
    background-color: #f9f9f9;
    border-radius: 8rpx;
  }
  
  .pdf-info {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
    width: 100%;
    justify-content: center;
  }
  
  .pdf-filename {
    font-size: 28rpx;
    color: #333;
    margin-left: 10rpx;
    flex: 1;
    text-align: left;
  }
  
  .empty-content {
    text-align: center;
    padding: 40rpx 0;
  }
  
  .empty-text {
    color: #999;
    font-size: 28rpx;
  }