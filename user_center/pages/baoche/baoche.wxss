.mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.5);
  z-index: 999;
}
.box_3{
  background: #fefefe;
  width: 80%;
  position: absolute;
  left: 50%; /* 移动元素到父容器的中央 */
  transform: translateX(-50%); /* 移动元素自身的一半宽度，实现完全居中 */
  top: 10%;
  border-radius: 20rpx;
  padding: 0 20rpx;
}
.buttonsView{
  width: 80%;
  position: absolute;
  left: 50%; /* 移动元素到父容器的中央 */
  transform: translateX(-50%); /* 移动元素自身的一半宽度，实现完全居中 */
  top: 85%;
  display: flex;
}
