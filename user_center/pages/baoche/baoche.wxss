/* ===== 底部支付方式弹框 ===== */
.pay-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.pay-sheet {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.pay-sheet-head {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.pay-sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #010101;
}

.pay-sheet-close {
  position: absolute;
  right: 0;
  top: -10rpx;
  font-size: 48rpx;
  line-height: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

.pay-sheet-phone {
  margin-top: 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #F08718;
  letter-spacing: 2rpx;
}

.pay-sheet-label {
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  color: #666;
}

/* ===== 支付立减优惠卡片 ===== */
.pay-promo {
  margin-top: 24rpx;
  background: #fdf0ec;
  border-radius: 16rpx;
  padding: 20rpx 20rpx 22rpx;
}

.pay-promo-head {
  display: flex;
  align-items: center;
}

.pay-promo-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff7a45 0%, #e60c0c 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.pay-promo-title {
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #e60c0c;
}

.pay-promo-detail {
  margin-left: auto;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #e60c0c;
  padding: 6rpx 0 6rpx 20rpx;
}

.pay-promo-arrow {
  margin-left: 6rpx;
  font-size: 24rpx;
  transition: transform 0.2s;
}

.pay-promo-arrow-up {
  transform: rotate(180deg);
}

.pay-promo-strip {
  margin-top: 16rpx;
  display: inline-block;
  background: linear-gradient(90deg, #ff8a3d 0%, #f5402a 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.pay-promo-list {
  margin-top: 16rpx;
  border-top: 2rpx dashed #f3c9bd;
  padding-top: 14rpx;
}

.pay-promo-item {
  position: relative;
  font-size: 24rpx;
  color: #b3341f;
  line-height: 44rpx;
  padding-left: 24rpx;
}

.pay-promo-item::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #e60c0c;
}

.pay-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
}

.pay-option-active {
  border-color: #F08718;
  background: #fff8ee;
}

.pay-option-main {
  display: flex;
  align-items: center;
}

.pay-option-logo {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
}

.pay-option-left {
  display: flex;
  flex-direction: column;
}

.pay-option-name {
  font-size: 30rpx;
  color: #010101;
  font-weight: 500;
}

.pay-option-tags {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.pay-option-tip {
  font-size: 24rpx;
  color: #e60c0c;
  margin-right: 12rpx;
}

.pay-option-tag {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(90deg, #ff6a3d 0%, #e60c0c 100%);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.pay-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  box-sizing: border-box;
  flex-shrink: 0;
}

.pay-radio-active {
  border: 12rpx solid #F08718;
  background: #fff;
}

.pay-sheet-btn {
  margin-top: 24rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(253, 209, 0, 1) 0%, rgba(240, 135, 24, 1) 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 20rpx;
}