            <view class="weui-cell__bd weui-cell_primary">
              <view class="font-28" wx:if="{{idcard}}">已认证</view>
              <view class="font-28" wx:if="{{!idcard}}">待认证</view>
            </view>
            <text class="weui-cell__ft"></text>
          </a>
          <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="toAddUser">
            <view class="weui-cell__hd">
              <image src="/user_center/assets/images/addUser.png" style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
