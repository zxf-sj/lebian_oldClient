<view class="container">
  <view class="sectionBox">
    <view class="head" bindtap="goMy">
      <view wx:if="{{avatar}}">
        <image class="head_img" src="{{avatar}}"></image>
      </view>
      <view wx:else>
        <image class="head_img" src="/user_center/assets/images/touxiang.png"></image>
      </view>
    </view>
    <text class="head_nick">{{nickName}}</text>
  </view>

  <view class="weui-panel">
    <!-- <view class="weui-panel__hd">小图文组合列表</view> -->
    <view class="weui-panel__bd">
      <view class="weui-media-box weui-media-box_small-appmsg">
        <view class="weui-cells">
          <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="checkList">
            <view class="weui-cell__hd">
              <image src="../../assets/images/icon-dingdan.png" style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
            </view>
            <view class="weui-cell__bd weui-cell_primary">
              <view class="font-28">订单中心</view>
            </view>
            <text class="weui-cell__ft"></text>
          </a>
          <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="checkList2">
            <view class="weui-cell__hd">
              <image src="../../assets/images/icon-dingdan.png" style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
            </view>
            <view class="weui-cell__bd weui-cell_primary">
              <view class="font-28">发票抬头管理</view>
            </view>
            <text class="weui-cell__ft"></text>
          </a>
          <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="goYue" wx:if="{{IsBalance=='100004-0000010001'}}">
            <view class="weui-cell__hd">
              <image src="../../assets/images/yue.png" style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
            </view>
            <view class="weui-cell__bd weui-cell_primary">
              <view class="font-28">余额管理</view>
            </view>
            <text class="weui-cell__ft"></text>
          </a>
          <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="goCoupon">
            <view class="weui-cell__hd">
              <image src="../../assets/images/icon-qianbao.png" style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
            </view>
            <view class="weui-cell__bd weui-cell_primary">
              <view class="font-28">次卡/优惠券列表</view>
            </view>
            <text class="weui-cell__ft"></text>
          </a>
          <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="goCika">
            <view class="weui-cell__hd">
              <image src="../../assets/images/icon-qianbao.png" style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
            </view>
            <view class="weui-cell__bd weui-cell_primary">
              <view class="font-28">次卡购买</view>
            </view>
            <text class="weui-cell__ft"></text>
          </a>
