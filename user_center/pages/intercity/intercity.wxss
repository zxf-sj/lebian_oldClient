
@import '../../../app.wxss';

.page {
  width: 100%;
  box-sizing: border-box;
  overflow-y: hidden;
}
.nav {
  overflow-y: hidden;
	width: 100%;
	height: 160rpx;
	background: linear-gradient(180deg, rgba(253,209,0,1) 0%,rgba(240,135,24,1) 100%);
	display: flex;
	align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}
.nav .tab_keep {
  height: 70%;
  flex: 1;
  color: #fff;
}
.nav .handle_keep {
  background-color: #fff;
  border-radius: 10rpx;
  color: #F08718;
}
.nav .tab_keep .item {
  width: 100%;
  text-align: center;
 
}
.main {
  overflow-y: hidden;
  padding: 0 20rpx;
  color: #fff;
  font-weight: 500;
}
.main .main_item {
  display: flex;
  justify-content: space-between;
  line-height: 160rpx;
  box-sizing: border-box;
  padding: 0 30rpx;
  height: 160rpx;
  margin-top: 20rpx;
  /* background: linear-gradient(180deg, rgba(253,209,0,1) 0%,rgba(240,135,24,1) 100%); */
  color: #101010;
  border-radius: 10rpx;
  box-shadow: 0 2px 4px rgb(0, 0, 0,.4), 0 0 6px rgba(0, 0, 0, .04);
  font-size: 14px;
}
.main .main_item .item_left {
  width: 30%;
  font-weight: 700;
  display: flex;
}
.main .main_item .item_center {
  flex: 1;
  display: flex;
}
.main .main_item .item_center .c_left {
  width: 12rpx;
  display: flex;
  flex-direction: column;
  padding: 30rpx 0;
}
.main .main_item .item_center .c_left .quan {
  width: 10rpx;
  height: 10rpx;
  background-color: #ccc;
  border-radius: 50%;
  border: 1px solid #ccc;
}
.main .main_item .item_center .c_left .xian {
  flex: 1;
  width: 1rpx;
  margin: 10rpx auto;
  background-color: #ccc;
}
.main .main_item .item_center .c_left .yuan {
  width: 10rpx;
  height: 10rpx;
  background-color: #fff;
  border: 1px solid #ccc;
  border-radius: 50%;
}
.main .main_item .item_center .c_right {
 flex: 1;
 display: flex;
 flex-direction: column;
 padding-left: 20rpx;
}
.main .main_item .item_center .c_right .starta {
width: 100%;
height: 70rpx;
line-height: 70rpx;
overflow: hidden;
margin-top: 2rpx;
