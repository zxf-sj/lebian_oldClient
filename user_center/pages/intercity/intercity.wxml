<view class="page">
  <view class="nav">
    <view class="tab_keep {{switchDate == 0 ? 'handle_keep' : ''}}" bindtap="switchDate" data-item="0" data-tody='{{day1}}' data-txt="今天">
      <view class="item">今天</view>
      <view class="item">{{day1}}</view>
    </view>
    <view class="tab_keep {{switchDate == 1 ? 'handle_keep' : ''}}" bindtap="switchDate" data-item="1" data-tody='{{day2}}' data-txt="明天">
      <view class="item">明天</view>
      <view class="item">{{day2}}</view>
    </view>
    <view class="tab_keep {{switchDate == 2 ? 'handle_keep' : ''}}" bindtap="switchDate" data-item="2" data-tody='{{day3}}' data-txt="后天">
      <view class="item">后天</view>
      <view class="item">{{day3}}</view>
    </view>
    <view class="tab_keep {{switchDate == 3 ? 'handle_keep' : ''}}" bindtap="switchDate" data-item="3" data-tody='{{day4}}' data-txt="{{week}}">
      <view class="item">{{week}}</view>
      <view class="item">{{day4}}</view>
    </view>
  </view>
  <view class="main">
    <view wx:for="{{seatList}}" wx:key="index" class="main_item {{handleItem == index ? 'soldOut' : ''}}" data-item="{{index}}" bindtap="handleItem" data-itemdata="{{item}}">
      <view class="item_left">
        <view class="c_left">
          <view class="quan"></view>
          <view class="xian"></view>
          <view class="yuan"></view>
        </view>
        <view class="c_right">
          <view class="starta">
            <view>{{item.startTime}}</view>
          </view>
          <view class="enda">{{item.endTime}}</view>
        </view>
      </view>
      <view class="item_center">
        <view class="c_left">
          <view class="quan"></view>
          <view class="xian"></view>
          <view class="yuan"></view>
        </view>
        <view class="c_right">
          <view class="starta">
            <view>{{item.startCity}}</view>
          </view>
          <view class="enda">{{item.endCity}}</view>
        </view>
      </view>
      <view class="item_right">
        <view class="money"> 
          <view class="number"  style="{{item.car_type=='枢纽直达'?'color: rgb(42 136 58)':'color: rgb(138 124 0)'}}">{{item.car_type}}</view>
        </view>
        <view class="num">余票 {{item.num}}</view>
      </view>
    </view>

  </view>
</view>