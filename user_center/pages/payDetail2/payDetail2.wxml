<!-- 已完成订单 -->
<block>
  <map class="map" id="map" style="width:100%;height:600rpx;" latitude="{{latitude}}" longitude="{{longitude}}" polyline="{{polyline}}" markers="{{markers}}" controls="{{controls}}" include-points='{{points}}' show-location="true">
  </map>
</block>
<block wx:if="{{!isClosed}}">
  <view class="over">
    <block>
      <view class="h2">
        <view class="str">{{detailData.StatingLocation_Name}}</view>
        <view class="car-img">
          <image src="/assets/images/line_mr.png"></image>
        </view>
        <view class="end">{{detailData.EndLocation_Name}}</view>
      </view>
    </block>
    <block wx:if="{{detailData.DispatchListId_DriverId_Name}}">
      <view class="driver-info">
        <view class="left">
          <image class="photo" src="{{detailData.driverCarInfo.driverHeadPicUrl || '/user_center/assets/images/driver.png'}}">
          </image>
          <view class="name"> {{driver_name}}师傅</view>
        </view>
        <view class="right">
          <view class="top">
            <view class="l">
              <view class="company">乐遍出行</view>
              <view class="car-num">{{detailData.DispatchListId_CarDirId_Name}}</view>
              <button type="primary" size="mini" plain="true" bind:tap="handleCallDriver">联系司机</button>
            </view>
          </view>
          <view class="btm">
            {{detailData.OnLineCarTypeId_Name?detailData.OnLineCarTypeId_Name:""}} {{detailData.DispatchListId_CarDirId_ExtProp11?detailData.DispatchListId_CarDirId_ExtProp11:""}}
          </view>
        </view>
        <view wx:if="{{detailData.DispatchListId_CarDirId_CarPicture}}">
          <image src="{{httpsUrl}}{{detailData.DispatchListId_CarDirId_CarPicture}}" style="width: 230rpx;height: 164rpx;"></image>
        </view>
        <view wx:else>
          <image src="https://www.qierchuxing.com/upload/Annex/202409/AX-20240906-513300-223.png" style="width: 230rpx;height: 164rpx;"></image>
        </view>
      </view>
    </block>
  </view>
  <view wx:if="{{steps.length > 0}}">
    <view class="container">
      <view class="progress-bar">
        <block wx:for="{{steps}}" wx:key="index">
          <view class="step-item">
            <!-- 步骤圆点 -->
            <view class="step-dot {{item.status === 'done' ? 'dot-done' : item.status === 'current' ? 'dot-current' : 'dot-pending'}}">
              <text wx:if="{{item.status === 'done'}}" class="icon">✓</text>
            </view>
            <!-- 步骤标签 -->
            <text class="step-text {{item.status}}">{{item.label}}</text>
            <!-- 连接线（除最后一个外） -->
            <view wx:if="{{index < steps.length - 1}}" class="connector" style="background-color: {{item.status === 'done' || item.status === 'current' ? '#4CAF50' : '#ddd'}}">
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
  <view class="orderOk" wx:if="{{detailData.FormState_Name == '未派单'}}">下单成功，发车前1小时显示车辆及司机信息。</view>
  <view class="orderOk" wx:if="{{detailData.BtnPay && status === 'active'}}">{{ mm }}:{{ ss }} 下单5分钟内未付款自动取消。</view>
  <view class="btn-list" style="justify-content: center;margin-top: 10rpx;">
    <view class="btn-area" wx:if="{{detailData.DispatchListId && detailData.FormState=='100004-0001020002'}}">
      <button catchtap="xingcheng" style="width: 250rpx !important;" class="xingcheng" data-ids="{{detailData.Id}}">查看行程</button>
    </view>
    <view class="btn-area" wx:if="{{detailData.BtnPay}}">
      <button type="primary" size="" disabled="{{pay_btn}}" catchtap="gotopay" data-ids="{{detailData.Id}}" style="font-size: 28rpx;width: 250rpx !important;">支付</button>
    </view>
    <view class="btn-area" wx:if="{{detailData.FormState  == '100004-0001020004'  && detailData.IsEvaluate=='100004-0000010002'}}">
      <button size="" catchtap="toComment" data-ids="{{detailData.Id}}" style="width: 250rpx !important;" class="pingjia">评价</button>
    </view>
  </view>
  <view class="container">
    <view class="shadow-box">
      <view class="shadow-box" wx:if="{{detailData.IsPickGoods != '100004-0000010001' && detailData.CarDirId_Name != ''}}">
      <block>
        <!-- <view class="pay-title">
          <text class="font-30">司机信息</text>
        </view> -->
        <view class="pay-detail">
          <!-- <block>
            <view class="border-bottom">
              <view class="flex-box font-28">
                <text class="mini-pay">车牌号</text>
                <text class="mini-pay">{{detailData.CarDirId_Name}}</text>
              </view>
            </view>
            <view class="border-bottom">
              <view class="flex-box font-28">
                <text class="mini-pay" style="min-width: 140rpx;">司机电话</text>
                <text class="mini-pay" style="color: blue;text-decoration: underline;" bind:tap="handlePhone" data-phone="{{detailData.DriverId_Phone}}">联系司机</text>
              </view>
            </view>
          </block> -->
        </view>
      </block>
    </view>
      <block>
        <view class="pay-title">
          <text class="font-30">订单信息</text>
        </view>
        <view class="pay-detail">
          <block>
            <view class="border-bottom">
              <view class="flex-box font-28">
                <text class="mini-pay">订单编号</text>
                <text class="mini-pay">{{detailData.OrderNo}}</text>
              </view>
            </view>
           
            <view class="border-bottom">
              <view class="flex-box font-28">
                <text class="mini-pay">付款金额</text>
                <text class="mini-pay">{{detailData.PayAmount}}</text>
              </view>
            </view>
            <view class="border-bottom">
              <view class="flex-box font-28">
                <text class="mini-pay">订单状态</text>
                <text class="mini-pay">{{detailData.OrderStatus_Name}}</text>
              </view>
            </view>
            <view class="border-bottom" wx:if="{{detailData.IsPickGoods != '100004-0000010001'}}">
              <view class="flex-box font-28">
                <text class="mini-pay">出发时间</text>
                <text class="mini-pay">{{detailData.DepartureTime}}</text>
              </view>
            </view>
           
            <view class="border-bottom">
              <view class="flex-box font-28">
                <text class="mini-pay">备注：</text>
                <text class="mini-pay">{{note}}</text>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>
    <view class="shadow-box" wx:if="{{detailData.IsPickGoods != '100004-0000010001'}}">
      <block>
        <view class="pay-title">
          <text class="font-30">乘客信息</text>
        </view>
        <view class="pay-detail">
          <block>
            <view class="border-bottom">
              <view class="flex-box font-28">
                <text class="mini-pay">乘客人数</text>
                <text class="mini-pay">{{detailData.TicketNum}}人</text>
              </view>
            </view>
            <view class="border-bottom">
              <view class="flex-box font-28">
                <text class="mini-pay" style="min-width: 140rpx;">乘客信息</text>
                <text class="mini-pay">{{detailData.PassengerPhone}}</text>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>
    
    <view class="shadow-box">
      <block>
        <view class="pay-title">
        </view>
        <view class="pay-detail">
          <block>
            <view class="border-bottom" wx:for="{{detailData.DetailList}}" wx:key="key">
              <view class="flex-box font-28">
                <text class="mini-pay">乘车费用</text>
                <text class="mini-pay" wx:if="{{item.DiscountMoney >0}}">-{{item.RealMoney}}元</text>
                <text class="mini-pay" wx:else>总计:<text style="font-size: 36rpx;color: red;">{{item.RealMoney}}</text>元</text>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>
  </view>
  <view class="btn-list">
    <view class="btn-area" wx:if="{{detailData.BtnCancel}}">
      <button type="warn" size="" catchtap="cancel" data-ids="{{detailData.Id}}" style="font-size: 28rpx;">取消</button>
    </view>
    <view class="btn-area" wx:if="{{detailData.BtnRefund}}">
      <button size="" catchtap="tuikuan" data-ids="{{detailData.Id}}" class="tuik">取消订单并申请退款</button>
    </view>
  </view>
</block>
<custom-input-modal
    show="{{modalShow}}"
    title="取消订单并申请退款"
    placeholder="请输入退款原因"
    prompt="{{prompt}}"
    value="{{modalValue}}"
    bind:confirm="onConfirm"
    bind:cancel="onCancel"
  />