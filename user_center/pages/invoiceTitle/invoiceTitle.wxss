/* user_center/pages/invoiceTitle/invoiceTitle.wxss */
.box {
    padding: 0 20rpx;
    background-color: #f3f4f6;
    height: 100vh;
}
.nav_icon {
    height: 140rpx;
    display: flex;
    color: #020202;
    background-color: #fff;
    margin-top: 20rpx;
    padding: 0 10rpx;
}
.nav_icon .item_l {
  height: 140rpx;
  flex: 1;
}
.nav_icon .item_l .pop_title {
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
  margin-top: 20rpx;
  color: #3b3b3b;
}
.nav_icon .item_l .pop_num {
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
  color: #9a9a9a;
}
.nav_icon .item_r {
    height: 140rpx;
    font-size: 40rpx;
    line-height: 140rpx;
    text-align: center;
}
.pop_bottom {
    width: 100%;
    height: 100rpx;
    position: absolute;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
      z-index: 999;
      align-self: start;
      margin-bottom: env(safe-area-inset-bottom);
      background-color: #4a4c5b;
      color: #fff;
      font-size: 28rpx;
    bottom: 0;
    left: 0;
    line-height: 100rpx;
    text-align: center;
}