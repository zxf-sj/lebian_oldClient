.container {
  padding: 40rpx 30rpx;
  background-color: #f9f9f9;
  font-family: 'PingFang SC', sans-serif;
}

/* 页面标题 */
.line-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 60rpx;
}

/* 主线路容器：包含竖线和所有站点 */
.bus-line-container {
  position: relative;
  margin-left: 80rpx; /* 为左侧点和线留空间 */
}

/* 中央垂直主线 */
.bus-line-container::before {
  content: '';
  position: absolute;
  left: 16rpx; /* 与 dot-wrapper 对齐 */
  top: 20rpx;
  bottom: 20rpx;
  width: 2rpx;
  background-color: #ddd;
  z-index: 1;
}

/* 每一行站点 */
.station-row {
  display: flex;
  align-items: center; /* 关键：让点和文字垂直居中对齐 */
  min-height: 90rpx;
  position: relative;
}

/* 圆点外层包装（用于精确定位） */
.dot-wrapper {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: absolute;
	left: -80rpx; /* 将点移至左侧主线位置 */
	top: 48rpx;
  z-index: 2;
}

/* 圆点通用样式 */
.dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
}

.dot.passed {
  background-color: #aaa;
}

.dot.current {
  width: 38rpx;
  height: 38rpx;
  background-color: #4CAF50;
}

.dot.next {
  background-color: #FF9800;
}

.dot.upcoming {
  background-color: #2196F3;
}

/* 文字内容区域 */
.text-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 站名（根据状态设置颜色） */
.station-name {
  font-size: 32rpx;
}

.station-name.passed {
  color: #aaa;
}

.station-name.current {
  color: #4CAF50;
  font-weight: bold;
}

.station-name.next {
  color: #FF9800;
}

.station-name.upcoming {
  color: #2196F3;
}

/* 当前站名字放大 */
.station-name.highlight {
  font-size: 44rpx;
}

/* 标签：到站 / 下一站 */
.tag {
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background-color: #4CAF50;
  color: white;
}

.tag.next-tag {
  background-color: #FF9800;
}
