/* pages/login/login.wxss */
@import '../../../styles/didi-btn.wxss';
page{
  width: 100%;
  height: 100vh;
  background-color: #f4f6f8;
}
.banner{
  width: 750rpx;
}

.banner image{
  width: 100%;
  height: 100vh;
  display: block;
}

.authBox{
  width: 100%;
  font-size: 28rpx;
  position: absolute;
  top:66%;
}

.authBox image{
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

.loginBtn{
  display: flex;
  justify-content: center;
  align-items: center;
  width:710rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  background-color:#1aad19;
  color:#fff;
  border:none;
  border-radius: 50rpx;
}
.logo{
  position: absolute;
  top:15%;
  left:23%;
}
.logoimg{
  width:450rpx;
  height:200rpx;
}
.signUp-tip{ 
  position: absolute;
  top:60%;
  left: 59%;
  transform: translateX(-50%);
  font-size: 26rpx;
  color: #999;
  height: 60rpx;
  line-height: 60rpx;
  width: 100%
}
.signUp-tip-txt{
  height: 60rpx;
  line-height: 60rpx;
}
.signUp-tip-txt-protocol{
  font-size: 28rpx;
  color: #0d88d0;
}
.logoname{
  position: absolute;
  top: 48%;
  text-align: center;
  width: 100%;
  font-size: 36rpx;
  font-weight: 800;
}
.checkHead{
  width: 100%;
  font-size: 28rpx;
  position: absolute;
  top: 58%;
}
.avatar-wrapper{
  width: 100rpx;
  height: 100rpx;
  padding: 0;
}
.avatar{
  width: 100rpx;
  height: 100rpx;
}
.weui-input{
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 28rpx;
  text-align: center;
}
.subBtn{
  width:35%;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
}
.loginBtn1{
  display: flex;
  justify-content: center;
  align-items: center;
  width:710rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  background-color:#0d88d0;
  color:#fff;
  border:none;
  border-radius: 50rpx;
  margin-top: 20rpx;
}