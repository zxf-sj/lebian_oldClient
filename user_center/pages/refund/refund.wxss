.section {
  padding: 20rpx 0 0 0;
  margin-bottom: 102rpx;
}

.section .title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.o-btn-group {
  display: flex;
  align-items: center;

}

.o-btn-group .w-btn {
