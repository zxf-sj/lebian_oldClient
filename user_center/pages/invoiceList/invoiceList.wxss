/* user_center/pages/invoiceList/invoiceList.wxss */

@import '../../../app.wxss';
page{
  width: 100%;
  background-color: #f0f0f0;
}

.container{
  height: 100vh;
  width: 100%;
  padding: 0 20rpx 40rpx 20rpx;
  box-sizing: border-box;
}

.hiddenBar{
  width: 100%;
  overflow: hidden;
  overflow-y: scroll;
  height: calc( 100vh - 230rpx);
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.listBox{
  width: 100%;
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-top: 1px solid #e0e0e0;
  box-sizing: border-box;
  border-radius: 5px;
  display: flex;
  align-items: center;
  height: 186rpx;
}

.flex-title {
  display: flex;
  justify-content: space-between;
  color: #333;
  line-height: 80rpx;
  align-items: center;
}

.status{
  color: #999;
}

.iconRight{
  width: 20rpx;
  height: 20rpx;
  display: inline-block;
  border-top: 1px solid #999;
  border-right: 1px solid #999;
  transform: rotate(45deg);
  margin-left: 20rpx;
}

.list-time{
  height: 60rpx;
  align-items: center;
}

.list-time image{
  width: 32rpx;
  height: 32rpx;
  vertical-align: middle;
  margin-right: 10rpx;
}

.time{
  vertical-align: text-top;
  color: #666;
}
.orderDetails {
    flex: 1;
    overflow: hidden;
}

.orderDetailss .item {
display: flex;
margin-bottom: 10rpx;
font-size: 14px;
}
.orderDetailss .item .item_l {
    text-align: left;
    flex: 1;
}
.orderDetailss .item .item_r {
    text-align: right;
    flex: 1;
}
.price {
    width: 130rpx;
    align-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-content: space-between;
    font-size: 14px;
    color: #666;
}
.car_type {
    width: 100%;
    text-align: right;
}
.price_box {
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    text-align: right;
}
.price_man {
    font-size: 18px;
    color: #333333;
    margin-right: 6rpx;
}
.list-adress{
  line-height: 60rpx;
  color: #666;
  overflow: hidden; /* 隐藏溢出的内容 */
  text-overflow: ellipsis; /* 显示省略符号来代表被修剪的文本 */
  white-space: nowrap;
}

.circle{
  height: 10px;
  width: 10px;
  display: inline-block;
  border-radius: 50%;
  margin: 0 20rpx 0 5rpx;
}

.circle-str{
  background: #3cbca3;
}

.circle-end{
  background: #fc9153;
}

.bg{
  padding: 0 50rpx;
  margin: 216rpx auto 0;
  text-align: center;
  color: #9A9A9A;
  font-size: 28rpx;
}

.bg-img{
  width: 324rpx;
  height: 317rpx;
  margin-bottom: 21rpx;
}

.bg-cont{
  color: #FF8008;
}
.btn-list{
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 10rpx;
}
.btn-area{
  width: 22%;
}
.tuik{
  background: #f1c00f;
  color: #fff;
}
.pingjia{
  background: #3cbca3;
  color: #fff;
}
.kaipiao{
  background: #fc9153;
  color: #fff;
}
.popup-box{
  position: absolute;
  z-index: 99;
  top: 0;
  background-color: rgba(0, 0, 0, 0.5);
  width: 100%;
  height: 100%;
}
/* 下 */
.info-bottom{
  position: fixed;
  z-index: 999;
  width: 100%;
  bottom: 0;
  background-color: white;
  border-top-left-radius: 10rpx;
  border-top-right-radius: 10rpx;
}
button{
  margin: 15rpx 0;
}
.row-info{
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 15rpx;
  font-size: 32rpx;
  height: 200rpx;
}
.row-info view{
  padding: 10rpx 0;
  margin-top: 20rpx;
}
.row-info view:first-child{
  display: flex;
  flex-direction: row;
  align-items: center;
}
.line{
  width: 100rpx;
  height: 1rpx;
}
.left-line{
  background-image: linear-gradient(to left,orange,white);
}
.right-line{
  background-image: linear-gradient(to right,orange,white);
}
.row-author{
  font-size: 24rpx;
  color: gray;
}
.row-btn{
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1rpx dashed #f1f1f1;
}
.row-btn view{
  flex: 1;
  text-align: center;
  margin: 20rpx 10%;
  padding: 12rpx 0;
  font-size: 32rpx;
  border-radius: 10rpx;
}
.left-btn{
  background-color: #f1f1f1;
  color: #33ccff;
}
.right-btn{
  background-color: #33ccff;
  color: white;
}
.fixed{
  position: fixed;
  bottom: 0;
  width: 50%;
}
.yutime{
  font-size: 28rpx;
  color: #777;
  margin-right: 20rpx;
}
.yue{
  position: relative;
  top: -8rpx;
  left: 550rpx;
  width: 100rpx;
  height: 100rpx;
  margin-top: -100rpx;
}
.yuimg{
  width: 100rpx;
  height: 100rpx;
}
.menu-box {
  position: fixed;
  width: 100rpx;
  padding-bottom: 100rpx;
}
.menu-box .navbar {
  z-index: 1000;
  position: absolute;
  bottom: 0rpx;
  width: 100rpx;
  height: 100rpx;
  text-align: center;
  background-color: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: 0rpx;
  border-radius: 50%;
}
.menu-box .navbar>.btn {
  padding: 25rpx;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}
.menu-box .navbar>.btn>.line1 {
  height: 6rpx;
  background-color: white;
  margin: 0px 2rpx 6rpx 2rpx;
  border-radius: 6rpx;
}
.menu-box .navbar>.btn>.title {
  font-size: 20rpx;
}
.menu-box .active {
  background-color: pink;
}
.menu-box .menu{
  /* width: 100rpx; */
  height: 100rpx;
  /* overflow: hidden; */
  position: relative;
  /* margin: 0 auto; */
  bottom: -100rpx;
}
.menu-box .menu>view {
  z-index: 100;
  background-color: rgba(0, 0, 0, 0.6);
  margin-bottom: 20rpx;
  border-radius: 50%;
  height: 100rpx;
  line-height: 100rpx;
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  margin-left: auto;
  margin-right: auto;
  opacity: 0;
  font-size: 0rpx;
  color: red;
}
.menu-box .menu>view text{
  display: inline-block;
  position: absolute;
  text-align: center;
  width:100%;
  height: 100%;
  color: white;
  z-index: 10000;
  font-size: 25rpx;
}
.menu_box{
  display: flex;
  height: 80rpx;
}
.menu1,.menu2{
  flex: 1;
  font-size:30rpx;
  line-height: 80rpx;
  text-align: center;
}
.borders{
  border-bottom: 4rpx solid #f00;
  color: #f00;
}
/* 吸底栏样式 */
.sticky-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100rpx;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    background-color: #ffffff;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
    z-index: 999;
    align-self: start;
    margin-bottom: env(safe-area-inset-bottom);
  }

  .btm_box {
    flex: 1;
    display: flex;
    justify-content: space-around;
  }
  .goinvoice {
   width: 150rpx;
   border-radius: 10rpx;
   color: #fff;
   padding: 5rpx 10rpx;
   display: flex;
   align-items: center;
   justify-content: center;
  }
  .interestthreecheckbox .wx-checkbox-input {
    border-radius: 50%;
    width: 35rpx;
    height: 35rpx;
  }
  .orderDetailss {
    flex: 1;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
    border-radius: 5px;
    align-items: center;
    height: 240rpx;
    color: #67686a;
    margin-bottom: 30rpx;
}
  .main {
      width: 100%;
      height: 160rpx;
      background-color: #f4f5f7;
  }
  .times {
      width: 100%;
      height: 80rpx;
      display: flex;
  }
 
  .times image {
    width: 40rpx;
    height: 40rpx;
  }
  .times .timeL {
    height: 100%;
    flex: 1;
    display: flex;
  }
  .imgs {
      width: 80rpx;
      height: 80rpx;
      line-height: 100rpx;
      text-align: center;
  }
  .timedata {
      flex: 1;
      height: 80rpx;
      line-height: 80rpx;
  }
  .times .go {
      width: 80rpx;
      height: 80rpx;
      line-height: 80rpx;
      text-align: center;
}
  .btm {
      width: 100%;
      height: 80rpx;
      background-color: #fff;
      display: flex;
      line-height: 80rpx;
  }
  .btm .types {
    width: 200rpx;
    height: 80rpx;
    text-align: center;
  }
  .btm .titles {
      height: 80rpx;
      flex: 1;
      text-align: center;
}
  .times {
      width: 100%;
      height: 80rpx;
      display: flex;
  }
  .prices {
      height: 80rpx;
      display: flex;
      line-height: 80rpx;
      padding-left: 30rpx;
  }
  .pri_l {
    height: 80rpx;
    flex: 1;
    display: flex;
    align-items: center;
  }
  .pri_l .btn {
      margin-left: 30rpx;
      border: 1px solid #cdced0;
      border-radius: 10rpx;
      width: 150rpx;
      height: 50rpx;
      line-height: 50rpx;
      text-align: center;
      font-size: 24rpx;
  }
  .pri_r {
      width: 200rpx;
      height: 80rpx;
      display: flex;
}
.pri_r .money {
    font-size: 40rpx;
    color: #343537;
    font-weight: 600;
    margin-right: 20rpx;
}
