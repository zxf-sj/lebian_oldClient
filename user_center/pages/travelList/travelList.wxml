      </view>
      <view class="list-time font-28">
        <text class="yutime">医院名称:</text>
        <text class="time">{{item.HospitalName}}</text>

      </view>
      <view class="list-time font-28" wx:if="{{item.IsPickGoods != '100004-0000010001'}}">
        <text class="yutime">预约类型:</text>
        <text class="time">{{item.PatientType_Name}}</text>
      </view>
      <view class="list-time font-28" wx:if="{{item.IsPickGoods != '100004-0000010001'}}">
