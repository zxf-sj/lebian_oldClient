        <text class="status" bindtap="orderDetail2" data-item="{{item}}" data-status="{{item.Id}}" data-dispatchlistid="{{item.DispatchListId}}">{{item.FormState_Name=='草稿'?'已取消':item.FormState_Name}}<text class="iconRight"></text></text>
      </view>
      <view class="list-time font-28">
        <image src="/user_center/assets/images/code.png"></image>
